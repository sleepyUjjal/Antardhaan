# Copy to .env and fill in. .env is gitignored — never commit real values.

# Neon pooled connection string. Use the "-pooler" host, not the direct one.
DATABASE_URL=""

# Admin dashboard password. 24+ characters, generated.
ADMIN_PASSWORD=""

# Signs the admin session cookie. 32+ bytes, generated.
SESSION_SECRET=""

# Absolute origin, no trailing slash. Used for copyable chamber URLs and OG tags.
NEXT_PUBLIC_SITE_URL=""
